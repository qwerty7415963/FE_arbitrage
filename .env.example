# Frontend environment — copy to .env.local or .env and fill in real values

# Public API endpoints
# Intentionally empty: client requests use /api/* same-origin proxy
# (next.config.ts rewrites /api/:path* -> BACKEND_URL, stripping /api)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_NAME=Arbitrage
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Server-side / internal API endpoints
BACKEND_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
